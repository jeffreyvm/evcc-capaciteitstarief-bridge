# capaciteit configuration.
# Copy to /etc/capaciteit/capaciteit.env and edit. Restart after changes:
#   systemctl restart capaciteit

# --- evcc ---------------------------------------------------------------
EVCC_URL=http://192.168.10.20:7070
# Long-lived API key (starts with evcc_). Create it in evcc:
# Settings -> Integrations -> API key. Leave empty if your evcc has no auth.
EVCC_API_KEY=
# Which loadpoint to steer. evcc numbers them from 1.
LOADPOINT_ID=1

# --- safety -------------------------------------------------------------
# true  = compute and display decisions, send nothing to evcc
# false = actually steer the charger and the battery
DRY_RUN=true
INTERVAL_S=15

# --- grid ---------------------------------------------------------------
# Leave at 0 to learn the month peak from measurements (recommended after the
# first full month). Set a kW value to pin the target, e.g. while you are
# still building history or if you want to aim below your real peak.
TARGET_PEAK_KW=0
GRID_PHASES=1
GRID_VOLTAGE=230

# --- charger ------------------------------------------------------------
MIN_CURRENT_A=6
MAX_CURRENT_A=32

# --- battery ------------------------------------------------------------
# Set false to run charge-current control only and leave the battery to evcc.
BATTERY_CONTROL=true
# SoC held back for peak shaving outside a release.
RESERVE_SOC=40
# SoC precharging aims for before a peak window opens.
TARGET_SOC=80
# Never discharge below this, even while shaving.
HARD_FLOOR_SOC=10
# How long before a window precharging may start.
PRECHARGE_LEAD_MIN=120
# Combined AC charge capability of your batteries, in watts.
BATTERY_MAX_CHARGE_W=2400
# Windows where a peak is likely. Local time, comma separated.
PEAK_WINDOWS=07:00-09:00,17:00-21:00

# --- dashboard ----------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8099

# --- misc ---------------------------------------------------------------
STATE_FILE=/var/lib/capaciteit/state.json
LOG_LEVEL=INFO
