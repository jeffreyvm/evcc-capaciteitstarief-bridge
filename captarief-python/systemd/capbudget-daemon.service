[Unit]
Description=Capbudget budgetteur (laag 1 - envelope naar MQTT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=capbudget
Group=capbudget
EnvironmentFile=/etc/capbudget.env
WorkingDirectory=/opt/capbudget
ExecStart=/usr/bin/python3 daemon.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
