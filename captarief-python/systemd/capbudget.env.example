# Kopieer naar /etc/capbudget.env, chmod 600, chown root:capbudget.
# Bevat een long-lived access token: nooit committen.

HA_URL=http://homeassistant.local:8123
HA_TOKEN=vervang-dit

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
TOPIC_ENVELOPE=capaciteit/circuit/maxpower
TOPIC_STATUS=capaciteit/status

INTERVAL_SEC=30
LOG_DIR=/var/lib/capbudget
LOG_INTERVAL_SEC=2
LOGLEVEL=INFO

WEB_HOST=0.0.0.0
WEB_PORT=8770
