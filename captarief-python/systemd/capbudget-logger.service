[Unit]
Description=Capbudget logger (stap 1 - meten, regelt niets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=capbudget
Group=capbudget
EnvironmentFile=/etc/capbudget.env
WorkingDirectory=/opt/capbudget
ExecStart=/usr/bin/python3 logger.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/capbudget

[Install]
WantedBy=multi-user.target
